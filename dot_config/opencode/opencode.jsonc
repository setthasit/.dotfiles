{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@ex-machina/opencode-anthropic-auth@1.8.1"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_TOKEN}",
      },
    },
    "expo-mcp": {
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:EXPO_TOKEN}",
      },
    },
    "astryx": {
      "type": "remote",
      "url": "https://astryx.atmeta.com/mcp",
      "enabled": false,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false,
    },
    "xcodebuild": {
      "type": "local",
      "command": ["npx", "-y", "xcodebuildmcp@latest", "mcp"],
      "enabled": false,
    },
  },
  "permission": {
    "bash": {
      "rm *": "ask",
      "git push *": "deny",
    },
  },
  "agent": {
    "explore": {
      "model": "anthropic/claude-sonnet-5",
      "variant": "medium",
    },
  },
  "compaction": {
    "auto": false,
  },
}
