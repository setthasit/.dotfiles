{{- $globs := list -}}
{{- range .approvals.gates -}}
{{-   range .commands -}}
{{-     $globs = concat $globs (includeTemplate "approval-globs" (dict "prefix" . "optionsFirst" $.approvals.optionsFirst) | fromJson) -}}
{{-   end -}}
{{-   if hasKey . "globs" -}}
{{-     $globs = concat $globs .globs -}}
{{-   end -}}
{{- end -}}
{{- $globs | toJson -}}
