{{- $rules := list -}}
{{- range .secrets.fileGlobs -}}
{{-   $glob := . -}}
{{-   $rules = append $rules (printf "Read(%s)" $glob) -}}
{{-   $pattern := printf "^%s$" ($glob | replace "." "\\." | replace "*" ".*") -}}
{{-   $shadowsReadable := false -}}
{{-   range $.secrets.readable -}}
{{-     if regexMatch $pattern . -}}
{{-       $shadowsReadable = true -}}
{{-     end -}}
{{-   end -}}
{{-   if not $shadowsReadable -}}
{{-     $rules = append $rules (printf "Read(//**/%s)" $glob) -}}
{{-   end -}}
{{- end -}}
{{- range .secrets.readable -}}
{{-   $rules = append $rules (printf "Read(!%s)" .) -}}
{{- end -}}
{{- range .secrets.homeDirs -}}
{{-   $rules = append $rules (printf "Read(~/%s/**)" .) -}}
{{- end -}}
{{- range .secrets.homeFiles -}}
{{-   $rules = append $rules (printf "Read(~/%s)" .) -}}
{{- end -}}
{{- $rules | toJson -}}
