{{- $globs := list
  "*git*--no-verify*"
  "git -* push*"
  "git push* main"
  "git push* main *"
  "git push*:main"
  "git push*:main *"
  "git push*/main"
  "git push*/main *"
  "git push* master"
  "git push* master *"
  "git push*:master"
  "git push*:master *"
  "git push*/master"
  "git push*/master *"
  "git push*+main"
  "git push*+main *"
  "git push*+master"
  "git push*+master *"
  "git push*--mirror*"
  "git push*--all*"
  "rm -rf /"
  "rm -rf ~"
  "rm -rf $HOME"
  (printf "rm -rf %s" .chezmoi.homeDir)
  "/bin/rm -rf /"
  "/bin/rm -rf ~"
  "mkfs*"
  "newfs*"
  "dd *of=/dev/*"
  "*dd *of=/dev/*"
  "shutdown*"
  "reboot*"
  "halt*"
  "* .env"
  "* .env.*"
  "*id_rsa*"
  "*id_ecdsa*"
  "*id_ed25519*"
  "*/.aws/credentials*"
  "*.pem*"
  "env"
  "printenv*"
  "security dump-keychain*"
  "security find-*-password*"
-}}
{{- concat $globs (includeTemplate "forbidden-globs" . | fromJson) | toJson -}}
