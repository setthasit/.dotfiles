{{- $names := list -}}
{{- range .secrets.fileGlobs -}}
{{-   $names = concat $names (list . (printf "*/%s" .)) -}}
{{-   if not (or (hasPrefix "." .) (hasPrefix "*" .)) -}}
{{-     $names = append $names (printf "*%s" .) -}}
{{-   end -}}
{{- end -}}
{{- $home := list -}}
{{- range .secrets.homeDirs -}}
{{-   $path := printf "%s/%s" $.chezmoi.homeDir . -}}
{{-   $home = concat $home (list . (printf "%s/*" .) (printf "*/%s" .) (printf "*/%s/*" .) $path (printf "%s/*" $path)) -}}
{{- end -}}
{{- range .secrets.homeFiles -}}
{{-   $home = concat $home (list . (printf "*/%s" .) (printf "%s/%s" $.chezmoi.homeDir .)) -}}
{{- end -}}
{{- $read := list (list "*" "allow") -}}
{{- range $names -}}
{{-   $read = append $read (list . "deny") -}}
{{- end -}}
{{- range .secrets.readable -}}
{{-   $read = concat $read (list (list . "allow") (list (printf "*/%s" .) "allow")) -}}
{{- end -}}
{{- range $home -}}
{{-   $read = append $read (list . "deny") -}}
{{- end -}}
{{- dict "names" $names "home" $home "read" $read | toJson -}}
