{{- $paths := list ".env" ".env.*" "*/.env" "*/.env.*" "*.pem" "*id_rsa*" "*id_ecdsa*" "*id_ed25519*" -}}
{{- range list ".ssh" ".aws" ".gnupg" ".kube" ".config/gh" -}}
{{-   $path := printf "%s/%s" $.chezmoi.homeDir . -}}
{{-   $paths = concat $paths (list . (printf "%s/*" .) (printf "*/%s" .) (printf "*/%s/*" .) $path (printf "%s/*" $path)) -}}
{{- end -}}
{{- range list ".netrc" ".zshrc.local" ".claude.json" ".codex/auth.json" ".local/share/opencode/auth.json" ".local/share/opencode/mcp-auth.json" -}}
{{-   $paths = concat $paths (list . (printf "*/%s" .) (printf "%s/%s" $.chezmoi.homeDir .)) -}}
{{- end -}}
{{- $paths | toJson -}}
