#!/bin/sh
# claude binary: {{ lookPath "claude" }}
# User-scope MCP servers live in ~/.claude.json, which is machine state and never
# managed, so they are registered through the CLI. The line above re-runs this
# script once Claude Code is installed or moves.
set -eu

command -v claude >/dev/null 2>&1 || exit 0

claude_config=$HOME/.claude.json

# An unchanged server is skipped because `claude mcp remove` also clears its OAuth login.
# A server deleted from the list stays registered: `claude mcp remove --scope user <name>`.
add_server() {
	if ! command -v jq >/dev/null 2>&1 || [ ! -f "$claude_config" ]; then
		claude mcp get "$1" >/dev/null 2>&1 || register "$@"
		return
	fi
	state=$(user_scope_state "$@") || fail_registration "$1"
	case $state in
	unchanged) ;;
	absent) register "$@" ;;
	changed)
		claude mcp remove --scope user "$1" >/dev/null || fail_registration "$1"
		register "$@"
		;;
	esac
}

user_scope_state() {
	jq -r --arg name "$1" --arg url "$2" --arg authorization "$3" '
		.mcpServers[$name] as $server
		| if $server == null then "absent"
		elif $server.url == $url and ($server.headers.Authorization // "") == $authorization then "unchanged"
		else "changed" end' "$claude_config"
}

register() {
	name=$1
	url=$2
	authorization=$3
	set --
	if [ -n "$authorization" ]; then
		set -- --header "Authorization: $authorization"
	fi
	claude mcp add --scope user --transport http "$name" "$url" "$@" || fail_registration "$name"
}

fail_registration() {
	echo "failed to register MCP server $1" >&2
	exit 1
}

# Single quotes on purpose: a ${VAR} reference is stored literally and expanded by
# Claude Code at connect time, so the token never reaches disk.
{{ range .mcpServers -}}
{{ $tokenEnv := get . "tokenEnv" -}}
{{ if not (and (regexMatch "^[A-Za-z0-9_-]+$" .name) (regexMatch "^https://[A-Za-z0-9./_-]+$" .url) (regexMatch "^([A-Z][A-Z0-9_]*)?$" $tokenEnv)) -}}
{{   fail (printf "MCP server %q: name, url, or tokenEnv holds a character this script cannot quote" .name) -}}
{{ end -}}
{{ if $tokenEnv -}}
# shellcheck disable=SC2016
add_server {{ .name | squote }} {{ .url | squote }} {{ printf "Bearer ${%s}" $tokenEnv | squote }}
{{ else -}}
add_server {{ .name | squote }} {{ .url | squote }} ''
{{ end -}}
{{ end -}}
