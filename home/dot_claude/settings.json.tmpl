{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "showThinkingSummaries": true,
  "preferredNotifChannel": "ghostty",
  "statusLine": {
    "type": "command",
    "command": "bash '{{ .chezmoi.homeDir }}/.claude/statusline.sh'",
    "refreshInterval": 10
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Agent(general-purpose)",
      "Agent(claude)",
      "Agent(Explore)",
      "Agent(Plan)",

      "Bash(*git*--no-verify*)",
      "Bash(git -* push*)",
      "Bash(git push* main)",
      "Bash(git push* main *)",
      "Bash(git push*:main)",
      "Bash(git push*:main *)",
      "Bash(git push*/main)",
      "Bash(git push*/main *)",
      "Bash(git push* master)",
      "Bash(git push* master *)",
      "Bash(git push*:master)",
      "Bash(git push*:master *)",
      "Bash(git push*/master)",
      "Bash(git push*/master *)",
      "Bash(git push*--mirror*)",
      "Bash(git push*--all*)",

      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(mkfs*)",
      "Bash(newfs*)",
      "Bash(dd *of=/dev/*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",

      "Bash(* .env)",
      "Bash(* .env.*)",
      "Bash(*id_rsa*)",
      "Bash(*/.aws/credentials*)",
      "Bash(*.pem*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(security dump-keychain*)",
      "Bash(security find-*-password*)",

      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(//**/.env)",
      "Read(//**/*.pem)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ecdsa*)",
      "Read(//**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.zshrc.local)",

      "Edit(~/.claude/settings*.json)"
    ],
    "ask": [
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.config/ai/AGENTS.md)",

      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push -u origin)",
      "Bash(git push --set-upstream origin)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push*--delete*)",
      "Bash(git push* -d *)",
      "Bash(git push* +*)",
      "Bash(git push* :**)",
      "Bash(git push*-tags*)",
      "Bash(git push* HEAD)",
      "Bash(git push* HEAD *)",
      "Bash(git push* @)",

{{- range .approvals.ask }}
{{-   range includeTemplate "approval-globs" (dict "prefix" . "optionsFirst" $.approvals.optionsFirst) | fromJson }}
      {{ printf "Bash(%s)" . | toJson }},
{{-   end }}
{{- end }}

      "Bash(git gc*--prune*)",

      "Bash(rm *..*)",
      "Bash(rm *~*)",
      "Bash(rm *tmp/* *)",
      "Bash(xargs -* rm*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",

      "Bash(vercel)",
      "Bash(vercel*--prod*)",
      "Bash(vercel*--target*)",
      "Bash(vercel* rm *)",
      "Bash(vercel* remove *)",
      "Bash(wrangler*deploy*)",
      "Bash(wrangler* delete*)",
      "Bash(wrangler*--remote*)",
      "Bash(supabase*deploy*)",
      "Bash(supabase* delete*)",
      "Bash(supabase*--linked*)",
      "Bash(supabase*--db-url*)",
      "Bash(supabase stop*--no-backup*)",
      "Bash(firebase*deploy*)",
      "Bash(firebase*delete*)",
      "Bash(eas build *)",
      "Bash(eas update*)",
      "Bash(eas*:delete*)",

      "Bash(docker compose*down* -v*)",
      "Bash(docker compose*down*--volumes*)",
      "Bash(docker * prune*)",

      "Bash(*prisma migrate reset*)",
      "Bash(*prisma migrate deploy*)",
      "Bash(*drizzle-kit push*)",
      "Bash(goose * down*)",
      "Bash(goose * reset*)",
      "Bash(*artisan migrate:fresh*)",
      "Bash(*artisan migrate:refresh*)",
      "Bash(*artisan migrate:reset*)",
      "Bash(*artisan migrate:rollback*)",
      "Bash(*artisan db:wipe*)",
      "Bash(*rails db:drop*)",
      "Bash(*rails db:reset*)",
      "Bash(*rails db:rollback*)",
      "Bash(*rails db:purge*)",
      "Bash(*rails db:migrate:reset*)",

      "Bash(npm install * -g*)",
      "Bash(npm install * --global*)",
      "Bash(npm i * -g*)",

      "Bash(gh api -X*)",
      "Bash(gh api* -f*)",
      "Bash(gh api* -F*)",
      "Bash(gh api* --field*)",
      "Bash(gh api* --raw-field*)",
      "Bash(gh api* --input*)"
    ],
    "allow": [
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git push --set-upstream origin *)",

      "Bash(rm tmp/*)",
      "Bash(rm -f tmp/*)",
      "Bash(rm -rf tmp/*)",
      "Bash(rm .tmp/*)",
      "Bash(rm -f .tmp/*)",
      "Bash(rm -rf .tmp/*)",
      "Bash(rm /tmp/agent/*)",
      "Bash(rm -f /tmp/agent/*)",
      "Bash(rm -rf /tmp/agent/*)"
    ]
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Non-Local Database [named+specifics — **must name:** the database or its host]: Connecting to, querying, writing to, or running migrations against a database that is not local, through any client, ORM, or migration CLI (e.g. `psql`, `mysql`, `mongosh`, `redis-cli`, `sqlite3` on a file outside the repo, `prisma migrate`, `alembic`, `goose`, `rails db:migrate`). Local means localhost, 127.0.0.1, a local socket, a database file inside the repo, a container started in this session, or a target CLAUDE.md lists under Known-safe targets. When the command does not show its target, judge by the transcript: a dev or test script, a local compose file, or the user saying the database is local clears it; an environment or host name carrying `prod`, `production`, `live`, or `staging` does not.",
      "New Dependency [named+specifics — **must name:** the package]: Installing or adding a package that the repo's manifest or lockfile does not already declare (e.g. `npm install foo`, `pip install foo`, `bun add foo`, `pnpm add foo`, `yarn add foo`, `cargo add foo`, `go get foo`). An agent-chosen name carries typosquat and supply-chain risk. Installing from the existing manifest or lockfile (`npm install`, `npm ci`, `pip install -r requirements.txt`) is not this rule."
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
