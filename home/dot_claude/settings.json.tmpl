{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "showThinkingSummaries": true,
  "preferredNotifChannel": "ghostty",
  "respectGitignore": false,
  "statusLine": {
    "type": "command",
    "command": "bash '{{ .chezmoi.homeDir }}/.claude/statusline.sh'",
    "refreshInterval": 10
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Agent(general-purpose)",
      "Agent(claude)",
      "Agent(Explore)",
      "Agent(Plan)",

      "Bash(*git*--no-verify*)",
      "Bash(git -* push*)",
      "Bash(git push* main)",
      "Bash(git push* main *)",
      "Bash(git push*:main)",
      "Bash(git push*:main *)",
      "Bash(git push*/main)",
      "Bash(git push*/main *)",
      "Bash(git push* master)",
      "Bash(git push* master *)",
      "Bash(git push*:master)",
      "Bash(git push*:master *)",
      "Bash(git push*/master)",
      "Bash(git push*/master *)",
      "Bash(git push*--mirror*)",
      "Bash(git push*--all*)",

      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(mkfs*)",
      "Bash(newfs*)",
      "Bash(dd *of=/dev/*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",

      "Bash(* .env)",
      "Bash(* .env.*)",
      "Bash(*id_rsa*)",
      "Bash(*/.aws/credentials*)",
      "Bash(*.pem*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(security dump-keychain*)",
      "Bash(security find-*-password*)",

      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(//**/.env)",
      "Read(//**/*.pem)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ecdsa*)",
      "Read(//**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.zshrc.local)",

      "Edit(~/.claude/settings*.json)"
    ],
    "ask": [
{{- range includeTemplate "gate-globs" . | fromJson }}
      {{ printf "Bash(%s)" . | toJson }},
{{- end }}

      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.config/ai/AGENTS.md)",

      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push -u origin)",
      "Bash(git push --set-upstream origin)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push*--delete*)",
      "Bash(git push* -d *)",
      "Bash(git push* +*)",
      "Bash(git push* :**)",
      "Bash(git push*-tags*)",
      "Bash(git push* HEAD)",
      "Bash(git push* HEAD *)",
      "Bash(git push* @)"
    ],
    "allow": [
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git push --set-upstream origin *)"
    ]
  },
  "autoMode": {
    "soft_deny": [
      "$defaults"
{{- range .approvals.reviewerRules }},
      {{ printf "%s [named+specifics — **must name:** %s]: %s" .label .mustName .rule | toJson }}
{{- end }}
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
