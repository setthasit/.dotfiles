{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "modelSettings": {
    "opus": {
      "effortLevel": "high"
    },
    "sonnet": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "showThinkingSummaries": true,
  "preferredNotifChannel": "ghostty",
  "respectGitignore": false,
  "statusLine": {
    "type": "command",
    "command": "bash '{{ .chezmoi.homeDir }}/.claude/statusline.sh'",
    "refreshInterval": 10
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Agent(general-purpose)",
      "Agent(claude)",
      "Agent(Explore)",
      "Agent(Plan)",

      "Bash(*git*--no-verify*)",
      "Bash(git -* push*)",
      "Bash(git push* main)",
      "Bash(git push* main *)",
      "Bash(git push*:main)",
      "Bash(git push*:main *)",
      "Bash(git push*/main)",
      "Bash(git push*/main *)",
      "Bash(git push* master)",
      "Bash(git push* master *)",
      "Bash(git push*:master)",
      "Bash(git push*:master *)",
      "Bash(git push*/master)",
      "Bash(git push*/master *)",
      "Bash(git push*--mirror*)",
      "Bash(git push*--all*)",

      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(mkfs*)",
      "Bash(newfs*)",
      "Bash(dd *of=/dev/*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",

      "Bash(* .env)",
      "Bash(* .env.*)",
      "Bash(*id_rsa*)",
      "Bash(*/.aws/credentials*)",
      "Bash(*.pem*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(security dump-keychain*)",
      "Bash(security find-*-password*)",
{{- range includeTemplate "forbidden-globs" . | fromJson }}
      {{ printf "Bash(%s)" . | toJson }},
{{- end }}
{{- range includeTemplate "claude-secret-reads" . | fromJson }}
      {{ toJson . }},
{{- end }}

      "Edit(~/.claude/settings*.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.config/ai/AGENTS.md)"
    ]
  },
  "autoMode": {
    "soft_deny": [
      "$defaults"
    ]
  },
  "sandbox": {
    "enabled": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
