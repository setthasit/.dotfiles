{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "modelSettings": {
    "opus": {
      "effortLevel": "high"
    },
    "sonnet": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "showThinkingSummaries": true,
  "preferredNotifChannel": "ghostty",
  "respectGitignore": false,
  "statusLine": {
    "type": "command",
    "command": "bash '{{ .chezmoi.homeDir }}/.claude/statusline.sh'",
    "refreshInterval": 10
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "{{ .chezmoi.homeDir }}/.claude/mods/plan-band:{{ .chezmoi.homeDir }}/.claude/mods/meter"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read(~/.claude/skills/**)",
      "Read(~/.agents/skills/**)"
    ],
    "deny": [
      "Agent(general-purpose)",
      "Agent(claude)",
      "Agent(Explore)",
      "Agent(Plan)",

{{- range includeTemplate "bash-deny-globs" . | fromJson }}
      {{ printf "Bash(%s)" . | toJson }},
{{- end }}
{{- range includeTemplate "claude-secret-reads" . | fromJson }}
      {{ toJson . }},
{{- end }}

{{- $protected := .protectedConfig.files }}
{{- range .protectedConfig.dirs }}
{{-   $protected = append $protected (printf "%s/**" .) }}
{{- end }}
{{- range $index, $path := $protected }}
{{- if $index }},{{ end }}
      {{ printf "Edit(~/%s)" $path | toJson }}
{{- end }}
    ]
  },
  "autoMode": {
    "soft_deny": [
      "$defaults"
    ]
  },
  "sandbox": {
    "enabled": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
