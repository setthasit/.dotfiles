setupVersion: 2
modelRoles:
  advisor: anthropic/claude-fable-5-1:xhigh
  tiny: anthropic/claude-sonnet-5-5:low
  plan: anthropic/claude-fable-5-1:xhigh
  task: anthropic/claude-opus-5-5:high
  smol: anthropic/claude-sonnet-5-5:medium
  slow: anthropic/claude-opus-5-5:xhigh
  commit: anthropic/claude-sonnet-5-5:low
  vision: anthropic/claude-opus-5-5:medium
  default: anthropic/claude-opus-5-5:high
  REVIEWER: anthropic/claude-opus-5-5:xhigh
  DESIGNER: anthropic/claude-opus-5-5:high
  TESTER: anthropic/claude-sonnet-5-5:high
  web: web/google
  memory: anthropic/claude-opus-5-5:high
retry:
  fallbackChains:
    plan:
      - anthropic/claude-opus-5
    advisor:
      - anthropic/claude-opus-5-5
    web:
      - web/public
      - web/parallel
      - web/perplexity
      - google/gemini-2.5-flash
      - google-antigravity/gemini-2.5-flash
      - anthropic/claude-haiku-4-5
      - openai-codex/gpt-5.6-luna
      - openai-codex/gpt-5.6
      - openai-codex/gpt-5.5
      - xai/grok-4.5
      - xai-oauth/grok-4.5
      - web/zai
      - web/exa
      - web/tinyfish
      - web/jina
      - web/kagi
      - web/tavily
      - web/firecrawl
      - web/brave
      - web/kimi
      - web/synthetic
      - web/ollama
      - web/searxng
      - web/startpage
      - web/duckduckgo
      - web/ecosia
      - web/mojeek
symbolPreset: nerd
theme:
  dark: titanium
composer:
  shape: box
cycleOrder:
  - default
  - smol
  - slow
bash:
  allowCompoundCommands: false
  patterns:
    # git push: plain `git push [-u] origin <branch>` runs unprompted.
    # main/master is never pushed. Force, delete, tags, HEAD, bare push prompt.
    - match: "*git*--no-verify*"
      approval: deny
    - match: git -* push*
      approval: deny
    - match: git push* main
      approval: deny
    - match: git push* main *
      approval: deny
    - match: "git push*:main"
      approval: deny
    - match: "git push*:main *"
      approval: deny
    - match: git push*/main
      approval: deny
    - match: git push*/main *
      approval: deny
    - match: git push* master
      approval: deny
    - match: git push* master *
      approval: deny
    - match: "git push*:master"
      approval: deny
    - match: "git push*:master *"
      approval: deny
    - match: git push*/master
      approval: deny
    - match: git push*/master *
      approval: deny
    - match: git push*--mirror*
      approval: deny
    - match: git push*--all*
      approval: deny
    - match: git push*--force*
      approval: prompt
    - match: git push* -f*
      approval: prompt
    - match: git push*--delete*
      approval: prompt
    - match: git push* -d *
      approval: prompt
    - match: git push* +*
      approval: prompt
    - match: "git push* :*"
      approval: prompt
    - match: git push*-tags*
      approval: prompt
    - match: git push* HEAD
      approval: prompt
    - match: git push* HEAD *
      approval: prompt
    - match: git push* @
      approval: prompt
    - match: git push -u origin *
      approval: allow
    - match: git push --set-upstream origin *
      approval: allow
    - match: git push origin *
      approval: allow
    - match: git push*
      approval: prompt
    - match: mkfs*
      approval: deny
    - match: newfs*
      approval: deny
    - match: dd *of=/dev/*
      approval: deny
    - match: shutdown*
      approval: deny
    - match: reboot*
      approval: deny
    - match: halt*
      approval: deny
    - match: "*.omp/agent/config.yml*"
      approval: deny
    - match: "* .env"
      approval: deny
    - match: "* .env.*"
      approval: deny
    - match: "*id_rsa*"
      approval: deny
    - match: "*/.aws/credentials*"
      approval: deny
    - match: "*.pem*"
      approval: deny
    - match: env
      approval: deny
    - match: printenv*
      approval: deny
    - match: security dump-keychain*
      approval: deny
    - match: security find-*-password*
      approval: deny
    - match: rm -rf /
      approval: deny
    - match: rm -rf ~
      approval: deny
    - match: rm -rf $HOME
      approval: deny
{{- range includeTemplate "gate-globs" . | fromJson }}
    - match: {{ . | toJson }}
      approval: prompt
{{- end }}
hideThinkingBlock: false
dev:
  autoqaConsent: granted