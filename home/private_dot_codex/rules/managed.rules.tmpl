prefix_rule(pattern=["git", "push", "origin", ["main", "master", "HEAD:main", "HEAD:master", "HEAD:refs/heads/main", "HEAD:refs/heads/master", "refs/heads/main", "refs/heads/master"]], decision="forbidden", justification="Push an explicitly named feature branch. Default-branch pushes require a user-managed policy change.")
prefix_rule(pattern=["git", "push", ["-u", "--set-upstream"], "origin", ["main", "master", "HEAD:main", "HEAD:master", "HEAD:refs/heads/main", "HEAD:refs/heads/master", "refs/heads/main", "refs/heads/master"]], decision="forbidden", justification="Push an explicitly named feature branch. Default-branch pushes require a user-managed policy change.")
prefix_rule(pattern=["git", "push", ["main", "master", "--mirror", "--all"]], decision="forbidden", justification="Use an explicitly named feature branch and remote.")
prefix_rule(pattern=["git", ["commit", "push"], "--no-verify"], decision="forbidden", justification="Run and fix the configured checks.")
prefix_rule(pattern=[["rm", "/bin/rm"], ["-rf", "-fr"], ["/", "~", "$HOME", {{ .chezmoi.homeDir | toJson }}]], decision="forbidden", justification="Remove only exact disposable paths inside the session scratch directory.")
prefix_rule(pattern=[["rm", "/bin/rm"], "-r", "-f", ["/", "~", "$HOME", {{ .chezmoi.homeDir | toJson }}]], decision="forbidden", justification="Remove only exact disposable paths inside the session scratch directory.")
prefix_rule(pattern=[["rm", "/bin/rm"], "-f", "-r", ["/", "~", "$HOME", {{ .chezmoi.homeDir | toJson }}]], decision="forbidden", justification="Remove only exact disposable paths inside the session scratch directory.")
prefix_rule(pattern=[["mkfs", "mkfs.ext2", "mkfs.ext3", "mkfs.ext4", "mkfs.xfs", "mkfs.btrfs", "newfs", "newfs_apfs", "newfs_hfs", "shutdown", "reboot", "halt"]], decision="forbidden", justification="Do not format devices or shut down the host from an agent session.")
prefix_rule(pattern=[["env", "printenv"]], decision="forbidden", justification="Reference the required variable name without dumping environment values.")
prefix_rule(pattern=["security", ["dump-keychain", "find-generic-password", "find-internet-password"]], decision="forbidden", justification="Ask the user to provide credentials out of band.")

prefix_rule(pattern=["git", "push"], decision="prompt")
prefix_rule(pattern=["git", ["-C", "--git-dir", "--work-tree"]], decision="prompt")
prefix_rule(pattern=["git", "branch", "-d"], decision="prompt")
prefix_rule(pattern=["git", "checkout", "--"], decision="prompt")
prefix_rule(pattern=[["rm", "xargs", "chown"]], decision="prompt")
prefix_rule(pattern=["kill", ["-SIGKILL", "-SIGTERM"]], decision="prompt")
prefix_rule(pattern=["docker", ["system", "container", "image", "volume", "network", "builder"], "prune"], decision="prompt")
prefix_rule(pattern=["prisma", "migrate"], decision="prompt")
prefix_rule(pattern=["drizzle-kit", "push"], decision="prompt")
prefix_rule(pattern=["npx", "prisma", "migrate"], decision="prompt")
prefix_rule(pattern=["npx", "drizzle-kit", "push"], decision="prompt")
prefix_rule(pattern=["php", "artisan", "migrate"], decision="prompt")
prefix_rule(pattern=["rails", ["db", "db:migrate", "db:reset", "db:drop", "db:seed"]], decision="prompt")
prefix_rule(pattern=["gh", "api"], decision="prompt")
prefix_rule(pattern=["npm", "i"], decision="prompt")

{{ range concat .approvals.ask .approvals.judge -}}
prefix_rule(pattern={{ splitList " " (includeTemplate "approval-prefix" .) | toJson }}, decision="prompt")
{{ end -}}
