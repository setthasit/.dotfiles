#!/bin/sh
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# Hooks are generated by herdr, never vendored: each carries a protocol version
# that must match the installed binary, so this re-runs when the mise pin moves.
set -eu

if command -v herdr >/dev/null 2>&1; then
	HERDR_BIN=herdr
elif command -v mise >/dev/null 2>&1; then
	HERDR_BIN=$(mise which herdr 2>/dev/null) || exit 0
else
	exit 0
fi

"$HERDR_BIN" integration install omp || echo "herdr integration install omp failed" >&2

mkdir -p "$HOME/.zsh/completions"
"$HERDR_BIN" completion zsh > "$HOME/.zsh/completions/_herdr"

"$HERDR_BIN" integration status
