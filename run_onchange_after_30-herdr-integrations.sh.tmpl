#!/bin/sh
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# Hooks are generated by herdr, never vendored: they embed the installed binary's
# path, so this re-runs whenever the mise pin moves.
set -eu

if command -v herdr >/dev/null 2>&1; then
	HERDR_BIN=herdr
elif command -v mise >/dev/null 2>&1; then
	HERDR_BIN=$(mise which herdr 2>/dev/null) || exit 0
else
	exit 0
fi

"$HERDR_BIN" integration install omp || echo "herdr integration install omp failed" >&2
"$HERDR_BIN" integration status
